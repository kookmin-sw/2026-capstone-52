# Google OAuth Client ID used by the browser login page.
# Create it in Google Cloud Console as an OAuth 2.0 Web client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=google-oauth-client-id.apps.googleusercontent.com

# Use the real backend API instead of mock/localStorage-backed frontend services.
# Set to "false" or leave unset when you want to use local frontend mock data.
NEXT_PUBLIC_USE_BACKEND_API=true

# FastAPI server origin used by Next.js rewrites.
# Browser requests to /api/backend/* are proxied to ${BACKEND_API_URL}/api/*.
BACKEND_API_URL=http://localhost:8000

# Optional: override the frontend API base URL used by features/api/client.js.
# For normal local development, leave this unset so the default /api/backend rewrite is used.
# If you set it, include the /api prefix, for example: http://localhost:8000/api
# NEXT_PUBLIC_API_BASE_URL=

# Optional: force a fixed backend user id during local development.
# When unset, the app stores the current user id in localStorage or creates a local dev user.
# NEXT_PUBLIC_EEUM_USER_ID=

# Optional: Playwright E2E target frontend URL.
# E2E_BASE_URL=http://localhost:3000
